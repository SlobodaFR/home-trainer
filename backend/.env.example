# SQLite database file path (optional, default: data/trainer.sqlite)
DATABASE_PATH=data/trainer.sqlite

# Public URL of the frontend — used for CORS and OAuth2 callback (required)
FRONTEND_URL=http://localhost:5173

# Port the backend listens on (optional, default: 3000)
PORT=3000

# Node environment (optional, default: development)
# Set to "production" in Docker
NODE_ENV=development

# home-auth OAuth2 client credentials (required)
AUTH_SERVICE_URL=https://auth.sloboda.fr
AUTH_CLIENT_ID=trainer
AUTH_CLIENT_SECRET=change-me

# Secret shared with home-auth for the session revocation webhook (required)
AUTH_WEBHOOK_SECRET=change-me

# Optional - key signing the logout webhook (home-auth contract PC7): paste it exactly as
# home-auth displays it once after "Régénérer" in its admin (64 lower-case hex characters,
# [0-9a-f]{64}; upper-case or any other form is refused at startup).
# Absent or blank: only the legacy ?secret= authenticates the webhook. A malformed value stops
# the startup. The flag auth-webhook-require-signature (home-features) makes it mandatory.
AUTH_WEBHOOK_SIGNING_SECRET=

# HMAC key pseudonymizing personal data in logs (required in production, >= 32 chars:
# openssl rand -base64 48). Optional in development.
# PSEUDONYM_SECRET=
# Reverse-proxy hops trusted for X-Forwarded-For (1 behind Caddy in production, 0 locally)
TRUST_PROXY_HOPS=0

# Optional - home-features feature flags (OFREP). Absent or invalid: flags disabled, the code
# default applies (startup is never blocked). https in production; server API key bound to the
# app and the environment (hf_ + 64 hex).
FEATURES_OFREP_URL=
FEATURES_API_KEY=
# Emergency pin of a flag, wins over home-features: FEATURES_PIN_<KEY_IN_UPPER_SNAKE>=true|false
# e.g. FEATURES_PIN_AUTH_VERIFY_TOKEN_CLAIMS=false

# Optional - ops telemetry (runtime_health + http_request) to PostHog, anonymous (no user id, no IP).
# Absent or blank: no client and no network call (startup never depends on PostHog).
POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
