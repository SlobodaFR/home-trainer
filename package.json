{
  "name": "trainer",
  "version": "1.0.0",
  "private": true,
  "description": "Strength & mobility training app — goal-driven planning, session execution, LLM progress analysis",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:frontend && npm run build:backend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --write .",
    "prepare": "husky",
    "lint:fix": "oxlint --type-aware --fix",
    "format:check": "oxfmt --check .",
    "typecheck": "npm run typecheck --workspace=backend && npx tsc -b --noEmit frontend"
  },
  "engines": {
    "node": ">=26"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml,css,html}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "@nestjs/core": false,
    "fsevents": false,
    "@scarf/scarf": false,
    "@swc/core": true
  }
}
